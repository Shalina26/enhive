<!DOCTYPE html>
<html lang="en-US">
<%- include("../includes/head", {title: "enhive | edit activity", styles:
  "/styles/form.css"}) %>

<body>
  <main>
    <a href="/"><img alt="logo" class="logo" src="/images/enhive.svg" /></a>
    <form action="/activities/<%= activity.slug %>" method="post">
      <div>
        <h3>Edit an activity</h3>
      </div>
      <div class="form-element">
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" class="input-field" value="<%= activity.name %>" />
      </div>
      <div class="form-element">
        <label for="venue">Venue:</label>
        <input type="text" id="venue" name="venue" class="input-field" value="<%= activity.venue %>" />
      </div>
      <div class="form-element">
        <label for="description">Description:</label>
        <input type="text" id="description" name="description" class="input-field" value="<%= activity.description %>" />
      </div>
      <div class="form-element">
        <label for="price">Price:</label>
        <input type="text" id="price" name="price" class="input-field" value="<%= activity.price %>" />
      </div>
      <div class="button">
        <button type="submit" class="primary-button">Update activity</button>
      </div>
    </form>
  </main>
</body>

</html>