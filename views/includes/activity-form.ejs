<form action="<%= url %>" method="post">
  <div>
    <h3><%= header %></h3>
  </div>
  <div class="error-message">
    <p><%= message ? message : '' %></p>
  </div>
  <div class="form-element">
    <label for="name">Name:</label>
    <input type="text" id="name" name="name" class="input-field" value="<%= formData ? formData.name : '' %>" />
  </div>
  <div class="form-element">
    <label for="venue">Venue:</label>
    <input type="text" id="venue" name="venue" class="input-field" value="<%= formData ? formData.venue : '' %>" />
  </div>
  <div class="form-element">
    <label for="description">Description:</label>
    <textarea type="text" id="description" name="description" class="input-field" rows="3"><%= formData ? formData.description : '' %></textarea>
  </div>
  <div class="form-element">
    <label for="price">Price:</label>
    <input type="text" id="price" name="price" class="input-field" value="<%= formData ? formData.price : '' %>" />
  </div>
  <div class="button">
    <button type="submit" class="primary-button"><%= buttonText %></button>
  </div>
</form>