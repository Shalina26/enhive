<li class="activity-card box-shadow">
  <a href="/activities/<%= activity.slug %>">
    <img class="activity-picture" alt="activity picture" src="/images/hiking.png" />
    <h4><%= activity.name %></h4>
    <p><%= activity.venue %></p>
    <p><%= createPriceInEuro(activity.price) %> €</p>
  </a>
</li>