<!DOCTYPE html>
<html lang="en-US">
<%- include("../includes/head", {title: "enhive | register", styles:
  "/styles/form.css"}) %>

<body>
  <main>
    <a href="/"><img alt="logo" class="logo" src="/images/enhive.svg" /></a>
    <form>
      <div>
        <h3>Create an account</h3>
      </div>
      <div class="form-element">
        <label for="firstName">First name:</label>
        <input type="text" id="firstName" name="firstName" class="input-field" />
      </div>
      <div class="form-element">
        <label for="lastName">Last name:</label>
        <input type="text" id="lastName" name="lastName" class="input-field" />
      </div>
      <div class="form-element">
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" class="input-field" />
      </div>
      <div class="form-element">
        <label for="username">Username:</label>
        <input type="text" id="username" name="username" class="input-field" />
      </div>
      <div class="form-element">
        <label for="password">Password:</label>
        <input type="password" id="password" name="password" class="input-field" />
      </div>
      <div class="button">
        <button type="submit" class="primary-button">Create</button>
      </div>
    </form>
  </main>
</body>

</html>